{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaJiHe",
    "description": "基于全新架构的 几何王国 小助手。图像技术 + 模拟控制，解放双手！【大部分任务从主界面开始识别执行】",
    "contact": "QQ: 1974843952",
    "license": "MIT",
    "welcome": "欢迎使用 几何王国 小助手！",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/lastoflast/MaaJiHe",
    "version": "1.1.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": ".*几何王国.*",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "FramePool", // 截图方式
                "mouse": "SendMessage", // 鼠标控制方式
                "keyboard": "SendMessage" // 键盘控制方式
            },
            "option": []
        },
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "巡逻",
            "entry": "场外识别券数量_领取巡逻奖励前",
            "group": [
                "上午",
                "下午"
            ],
            "default_check": true,
            "description": "（未考虑到升级的情况）"
        },
        {
            "name": "收菜助力",
            "entry": "收菜助力",
            "group": [
                "上午"
            ],
            "default_check": true
        },
        {
            "name": "主线一关",
            "entry": "场外识别券数量_挑战主线前",
            "group": [
                "上午",
                "工具"
            ],
            "default_check": true,
            "description": "仅打一关。（未考虑到升级的情况）"
        },
        {
            "name": "快速巡逻",
            "entry": "场外识别券数量_快速巡逻前",
            "description": "默认免费+50钻巡逻。（未考虑到升级的情况）",
            "group": [
                "上午"
            ],
            "default_check": true,
            "option": [
                "快速巡逻模式"
            ]
        },
        {
            "name": "试炼之地",
            "entry": "点击冒险_试炼之地",
            "description": "仅扫荡免费次数。",
            "group": [
                "上午"
            ],
            "default_check": true
        },
        {
            "name": "王座之塔",
            "entry": "点击冒险_王座之塔",
            "description": "非爬塔仅送死，请自行上阵1级角色。默认执行3次。",
            "group": [
                "上午"
            ],
            "default_check": true,
            "option": [
                "送死次数"
            ]
        },
        {
            "name": "隐秘圣所",
            "entry": "场外识别券数量_进入隐秘圣所前",
            "group": [
                "上午"
            ],
            "default_check": true
        },
        {
            "name": "黑暗之门",
            "entry": "点击冒险_黑暗之门",
            "description": "请自行升级军需官。（网页端左右侧不要留黑边）",
            "group": [
                "上午"
            ],
            "default_check": true
        },
        {
            "name": "部落试炼",
            "entry": "进入部落_部落试炼",
            "group": [
                "上午"
            ],
            "default_check": true
        },
        {
            "name": "每日任务",
            "entry": "点击菜单_任务",
            "group": [
                "上午"
            ],
            "default_check": true
        },
        {
            "name": "竞技场",
            "entry": "进入竞技场",
            "description": "自动碾压或挑战，领取排名奖励和宝箱。",
            "group": [
                "上午",
                "下午",
                "工具"
            ],
            "default_check": true
        },
        {
            "name": "大厅升级",
            "entry": "点击菜单_大厅",
            "group": [
                "上午"
            ],
            "default_check": true
        },
        {
            "name": "助力",
            "entry": "仅助力",
            "group": [
                "下午"
            ],
            "default_check": true,
            "option": [],
            "description": "偶尔会卡住。"
        },
        {
            "name": "自动祈愿",
            "entry": "点击招募_祈愿",
            "group": [
                "工具"
            ],
            "option": [
                "自定义次数"
            ]
        },
        {
            "name": "兑换码",
            "entry": "点击菜单_兑换码",
            "group": [
                "工具"
            ],
            "pipeline_override": {},
            "default_check": false,
            "description": "请自行填入已收集的兑换码",
            "option": [
                "第一个兑换码",
                "第二个兑换码",
                "第三个兑换码"
            ]
        },
        {
            "name": "进入部落争霸",
            "entry": "进入部落争霸",
            "group": [
                "部落争霸"
            ],
            "description": "是购买部落争霸礼包和建设部落的必要前置流程。",
            "default_check": true
        },
        {
            "name": "部落争霸购买礼包",
            "entry": "点击礼包_部落争霸",
            "group": [
                "部落争霸"
            ],
            "option": [
                "购买攻城令"
            ],
            "default_check": true
        },
        {
            "name": "建设部落",
            "entry": "点击建设",
            "group": [
                "部落争霸"
            ],
            "default_check": true,
            "description": "默认免费捐赠5次。"
        },
        {
            "name": "退出部落争霸",
            "entry": "退出部落争霸",
            "group": [
                "部落争霸"
            ],
            "default_check": true
        },
        {
            "name": "攻击部落",
            "entry": "攻击部落",
            "description": "需先选定好目标部落，默认攻击15次，不满足攻城令使用条件时停止攻击。",
            "option": [
                "使用攻城令"
            ],
            "group": [
                "部落争霸"
            ]
        },
        {
            "name": "浮空秘境购买礼包",
            "entry": "进入浮空秘境",
            "option": [
                "购买体力药"
            ],
            "group": [
                "工具"
            ]
        }
    ],
    "option": {
        "自定义次数": {
            "type": "input",
            "cases": [],
            "default_case": [],
            "inputs": [
                {
                    "pipeline_type": "int",
                    "name": "循环次数",
                    "default": "5",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入正整数",
                    "password": false
                }
            ],
            "pipeline_override": {
                "开始祈愿": {
                    "max_hit": "{循环次数}"
                }
            }
        },
        "送死次数": {
            "type": "select",
            "cases": [
                {
                    "name": "1次",
                    "pipeline_override": {
                        "票数大于n时重复执行": {
                            "max_hit": 1
                        }
                    }
                },
                {
                    "name": "3次",
                    "pipeline_override": {
                        "票数大于n时重复执行": {
                            "max_hit": 3
                        }
                    }
                },
                {
                    "name": "10次",
                    "pipeline_override": {
                        "票数大于n时重复执行": {
                            "max_hit": 10
                        }
                    }
                }
            ],
            "default_case": "3次"
        },
        "输入兑换码": {
            "type": "input",
            "cases": [],
            "inputs": [
                {
                    "name": "兑换码<1>",
                    "pipeline_type": "string",
                    "verify": "^([A-Za-z]{4}[0-9]{2})?$",
                    "pattern_msg": "请输入6个字符，前4位为字母，后2位为数字（例如：Abcd12）。"
                },
                {
                    "name": "兑换码<2>",
                    "pipeline_type": "string",
                    "verify": "^([A-Za-z]{4}[0-9]{2})?$",
                    "pattern_msg": "请输入6个字符，前4位为字母，后2位为数字（例如：Abcd12）。"
                },
                {
                    "name": "兑换码<3>",
                    "pipeline_type": "string",
                    "verify": "^([A-Za-z]{4}[0-9]{2})?$",
                    "pattern_msg": "请输入6个字符，前4位为字母，后2位为数字（例如：Abcd12）。"
                }
            ],
            "description": "请输入6个字符，前4位为字母，后2位为数字（例如：Abcd12）。",
            "pipeline_override": {
                "输入兑换码<1>": {
                    "input_text": "{兑换码<1>}"
                },
                "输入兑换码<2>": {
                    "input_text": "{兑换码<2>}"
                },
                "输入兑换码<3>": {
                    "input_text": "{兑换码<3>}"
                }
            }
        },
        "购买攻城令": {
            "type": "switch",
            "cases": [
                {
                    "pipeline_override": {
                        "购买攻城令": {
                            "max_hit": 3
                        }
                    },
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "购买攻城令": {
                            "max_hit": 0
                        }
                    }
                }
            ],
            "description": "购买3次或不购买。（默认购买）",
            "default_case": "Yes"
        },
        "快速巡逻模式": {
            "type": "select",
            "cases": [
                {
                    "name": "免费",
                    "pipeline_override": {
                        "领取快速巡逻奖励": {
                            "template": [
                                "快速巡逻/0钻.png"
                            ]
                        }
                    }
                },
                {
                    "name": "免费+50",
                    "pipeline_override": {
                        "领取快速巡逻奖励": {
                            "template": [
                                "快速巡逻/0钻.png",
                                "快速巡逻/50钻.png"
                            ]
                        }
                    }
                },
                {
                    "name": "免费+50+100",
                    "pipeline_override": {
                        "领取快速巡逻奖励": {
                            "template": [
                                "快速巡逻/0钻.png",
                                "快速巡逻/50钻.png",
                                "快速巡逻/100钻.png"
                            ]
                        }
                    }
                }
            ],
            "default_case": "免费+50"
        },
        "使用攻城令": {
            "type": "select",
            "cases": [
                {
                    "name": "不使用",
                    "pipeline_override": {
                        "消耗n个攻城令": {
                            "expected": [
                                "令城攻个0耗消"
                            ]
                        }
                    }
                },
                {
                    "name": "1个",
                    "pipeline_override": {
                        "消耗n个攻城令": {
                            "expected": [
                                "消耗1个攻城令"
                            ]
                        }
                    }
                },
                {
                    "name": "1~2个",
                    "pipeline_override": {
                        "消耗n个攻城令": {
                            "expected": [
                                "消耗1个攻城令",
                                "消耗2个攻城令"
                            ]
                        }
                    }
                }
            ]
        },
        "购买体力药": {
            "type": "switch",
            "cases": [
                {
                    "pipeline_override": {
                        "购买体力药": {
                            "max_hit": 1
                        }
                    },
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "购买体力药": {
                            "max_hit": 0
                        }
                    }
                }
            ],
            "description": "购买1次或不购买。（默认购买）",
            "default_case": "Yes"
        },
        "第一个兑换码": {
            "type": "input",
            "cases": [],
            "inputs": [
                {
                    "pipeline_type": "string",
                    "verify": "^([A-Za-z]{4}[0-9]{2})?$",
                    "pattern_msg": "请输入6个字符，前4位为字母，后2位为数字（例如：Abcd12）。",
                    "name": "兑换码<1>"
                }
            ],
            "pipeline_override": {
                "输入兑换码<1>": {
                    "input_text": "{兑换码<1>}"
                }
            }
        },
        "第二个兑换码": {
            "type": "input",
            "cases": [],
            "inputs": [
                {
                    "name": "兑换码<2>",
                    "pipeline_type": "string",
                    "verify": "^([A-Za-z]{4}[0-9]{2})?$",
                    "pattern_msg": "请输入6个字符，前4位为字母，后2位为数字（例如：Abcd12）。"
                }
            ],
            "pipeline_override": {
                "输入兑换码<2>": {
                    "input_text": "{兑换码<2>}"
                }
            }
        },
        "第三个兑换码": {
            "type": "input",
            "cases": [],
            "inputs": [
                {
                    "name": "兑换码<3>",
                    "pipeline_type": "string",
                    "verify": "^([A-Za-z]{4}[0-9]{2})?$",
                    "pattern_msg": "请输入6个字符，前4位为字母，后2位为数字（例如：Abcd12）。"
                }
            ],
            "pipeline_override": {
                "输入兑换码<3>": {
                    "input_text": "{兑换码<3>}"
                }
            }
        }
    },
    "group": [
        {
            "name": "上午"
        },
        {
            "name": "下午"
        },
        {
            "name": "工具"
        },
        {
            "name": "部落争霸"
        }
    ],
    "icon": "resource/image/几何王国.png"
}
